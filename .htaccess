Options -Indexes

RewriteEngine On

# Force HTTPS
RewriteCond %{SERVER_PORT} !=443
RewriteRule ^(.*)$ https://khayrullo.com/$1 [R=301,L]

# Language prefix routing — serve per-language static files
RewriteRule ^(es|fr|ca)/?$ /$1/index.html [L]
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
RewriteRule ^(es|fr|ca)/([^.]+)$ /$1/$2.html [L]

# Remove .html extension from URLs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# Custom error pages
ErrorDocument 404 /404.html
ErrorDocument 500 /status.html?type=500
